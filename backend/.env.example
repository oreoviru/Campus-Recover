# ============================================================
# Campus Recover — Environment Variables (Example)
# Copy this to .env and fill in your values
# ============================================================

# --- Application ---
APP_NAME=CampusRecover
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# --- Database ---
DATABASE_URL=postgresql://campus_user:campus_pass@localhost:5432/campus_recover

# --- Authentication ---
JWT_SECRET_KEY=change-this-to-a-random-256-bit-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Security & Rate Limiting ---
ALLOWED_ORIGINS=http://localhost:5173,https://campusrecovery.vercel.app,https://campus-recovery-app.vercel.app
ALLOWED_EMAIL_DOMAINS=rishihood.edu.in,nst.rishihood.edu.in
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=150
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_CLAIM_PER_MINUTE=15
RATE_LIMIT_UPLOAD_PER_MINUTE=20

# --- Storage ---
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# --- AI Matching ---
AI_TEXT_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_IMAGE_MODEL=openai/clip-vit-base-patch32
MATCH_THRESHOLD=0.40
TEXT_WEIGHT=0.30
IMAGE_WEIGHT=0.25
LOCATION_WEIGHT=0.20
TIME_WEIGHT=0.10
ATTRIBUTE_WEIGHT=0.15

# --- Location Thresholds (meters) ---
LOCATION_VERY_HIGH=50
LOCATION_HIGH=200
LOCATION_MEDIUM=500
LOCATION_LOW=1000

# --- Optional Cloud Storage (Phase 9+) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
